{
  "$schema": "https://vercel.sh",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    },
    "dld-simulator": {
      "root": "artifacts/dld-simulator",
      "framework": "vite",
      "buildCommand": "PORT=3000 pnpm run build"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "PORT=3000 pnpm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/sandbox/(.*)",
      "destination": { "service": "mockup-sandbox" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "dld-simulator" }
    }
  ]
}


